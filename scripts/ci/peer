def main(args):
    peers = os.path.join(os.environ.get("BACKEND_DIR") or "", "peers")
    if len(args) < 2 or args[1] not in COMMANDS:
        print(HELP)
        if os.path.isdir(peers):
            print(f"\npeers so far: {', '.join(sorted(os.listdir(peers))) or 'none'}")
        return 1
    if not os.environ.get("BACKEND_DIR"):
        print("error: the test backend is not running in this session, so there are no peers")
        return 1
    command = COMMANDS[args[1]]
    try:
        peer = Peer(args[0], peers)
        try:
            inspect.signature(command).bind(peer, *args[2:])
        except TypeError:
            raise Usage(f"wrong number of arguments for {args[1]}")
        return command(peer, *args[2:])
    except Usage as e:
        print(f"error: {e}")
    except subprocess.TimeoutExpired:
        print("error: the peer's command did not finish in time")
    print("\n".join(line for line in HELP.splitlines() if line.strip().startswith(args[1] + " ") or line.strip() == args[1]))
    return 2


sys.exit(main(sys.argv[1:]))
