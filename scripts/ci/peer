    "voice": voice,
    "receive": lambda p, i: p.run(f"/fr {number(i, 1, 1000000, 'file id')} approved_relays=on", 30),
    "messages": messages,
    "wait": wait,
    "chats": lambda p: p.run("/chats", 5),
    "group": lambda p, name: p.run(f"/g {check(GROUP_NAME, name, 'group name')}", 10),
    "invite": invite,
    "join": lambda p, g: p.run(f"/j {group(g)}", 30),
