# What the Claude job needs for the session its prompt describes.
# backend: yes when the prompt uses the test backend; a run that asks for Claude must then start it too.
# prompt (optional) names the prompt file in this directory, claude-test.md when it is absent.
# model, max-turns and max-budget-usd (optional) choose the model and bound the session; claude-test.sh uses the
# workflow's CLAUDE_MODEL, 60 and 3 when they're absent.
backend: no
prompt: claude-test-passphrase.md
model: claude-sonnet-5-5
max-turns: 200
max-budget-usd: 15
